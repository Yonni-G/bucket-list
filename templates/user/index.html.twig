{% extends 'base.html.twig' %}

{% block title %}Hello UserController!{% endblock %}

{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>

<div class="example-wrapper">
    <h1>Hello {{ controller_name }}! ✅</h1>

    <form method="post">
        {{ form_start(form) }}

        <div class="form-group">
            {{ form_label(form.nom) }}
            {{ form_widget(form.nom, {'attr': {'class': 'form-control'}}) }}

            {# Afficher immédiatement l'erreur s'il y en a une #}
            {% if form.nom.vars.errors|length > 0 %}
                <div class="text-danger">
                    {{ form_errors(form.nom) }}
                </div>
            {% endif %}
        </div>
        {{ form_end(form) }}
    </form>
    <input type="text" id="adresse" placeholder="Saisissez votre adresse" />
    <ul id="suggestions"></ul>

</div>

    <script>document.getElementById("adresse").addEventListener("input", function () {
            let query = this.value;
            if (query.length < 3) return; // Évite les requêtes inutiles

            fetch(`https://api-adresse.data.gouv.fr/search/?q=${query}`)
                .then(response => response.json())
                .then(data => {
                    let suggestions = document.getElementById("suggestions");
                    suggestions.innerHTML = "";
                    data.features.forEach(feature => {
                        let li = document.createElement("li");
                        li.textContent = feature.properties.label;
                        li.addEventListener("click", function () {
                            document.getElementById("adresse").value = feature.properties.label;
                            suggestions.innerHTML = "";
                        });
                        suggestions.appendChild(li);
                    });
                });
        });
    </script>
{% endblock %}
